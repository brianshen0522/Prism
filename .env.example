# ── Prism DB (managed by Docker Compose) ──────────────────────────────────────
PROXY_DB_HOST=postgres-prism        # service name inside Docker Compose network
PROXY_DB_PORT=5432
PROXY_DB_NAME=prism
PROXY_DB_USER=prism
PROXY_DB_PASS=change_me_strong_password

# ── Gazelle DB (read-only, existing IHE Connectathon PostgreSQL 9.6) ──────────
GAZELLE_DB_HOST=gazelle-db.example.com
GAZELLE_DB_PORT=5432
GAZELLE_DB_NAME=gazelle
GAZELLE_DB_USER=gazelle_readonly
GAZELLE_DB_PASS=gazelle_password
GAZELLE_DB_SSL=false                # set to true if Gazelle requires SSL

# ── App ───────────────────────────────────────────────────────────────────────
APP_PORT=3000
NODE_ENV=production

# ── Proxy port range ──────────────────────────────────────────────────────────
# One port is allocated per backend server. Ensure this range is open in your
# firewall and exposed by Docker Compose (see docker-compose.yml).
PROXY_PORT_START=7001
PROXY_PORT_END=7100

# ── JWT secrets ───────────────────────────────────────────────────────────────
# Generate with:  openssl rand -hex 64
JWT_SECRET=replace_with_at_least_32_random_characters_aaaaaaaaaaaaaaaa
JWT_EXPIRES_IN=8h
JWT_REFRESH_SECRET=replace_with_a_different_32_char_secret_bbbbbbbbbbbbb
JWT_REFRESH_EXPIRES_IN=7d
PARTICIPANT_TOKEN_SECRET=replace_with_a_third_32_char_secret_cccccccccccccccc
