AUTH_PORT=4010
RESOURCE_PORT=4020
PARTICIPANT_HEADER_NAME=X-Participant-Token
AUTH_TOKEN_ENDPOINT=/oauth/token
AUTH_VALIDATE_ENDPOINT=/oauth/validate
VALIDATION_SUCCESS_PATH=active
VALIDATION_SUCCESS_VALUE=true
AUTH_VALIDATE_BASE_URL=http://127.0.0.1:4010
CLIENT_AUTH_BASE_URL=http://oauth-simulator:4010
CLIENT_RESOURCE_BASE_URL=http://oauth-simulator:4020
PARTICIPANT_TOKEN_VALUE=demo-participant-token
