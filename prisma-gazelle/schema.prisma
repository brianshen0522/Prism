generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/gazelle-client"
}

datasource db {
  provider = "postgresql"
  url      = env("GAZELLE_DATABASE_URL")
}

model GazelleUser {
  id            Int                 @id
  username      String              @unique
  password      String
  email         String?
  firstname     String?
  lastname      String?
  institutionId Int?                @map("institution_id")
  activated     Boolean?            @default(false)
  blocked       Boolean?            @default(false)
  lastLogin     DateTime?           @map("last_login")
  creationDate  DateTime?           @map("creation_date")
  institution   GazelleInstitution? @relation(fields: [institutionId], references: [id])
  roles         GazelleUserRole[]

  @@map("usr_users")
}

model GazelleInstitution {
  id        Int           @id
  name      String
  keyword   String?
  activated Boolean?      @default(false)
  url       String?
  note      String?
  users     GazelleUser[]

  @@map("usr_institution")
}

model GazelleUserRole {
  userId Int         @map("user_id")
  roleId Int         @map("role_id")
  user   GazelleUser @relation(fields: [userId], references: [id])

  @@id([userId, roleId])
  @@map("usr_user_role")
}
