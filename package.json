{
  "name": "prism",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "tsc --project tsconfig.json && npm run build:client",
    "build:client": "cd client && npm run build",
    "dev": "tsx watch src/index.ts",
    "dev:client": "cd client && npm run dev",
    "start": "node dist/index.js",
    "db:generate": "prisma generate --schema=prisma/schema.prisma && prisma generate --schema=prisma-gazelle/schema.prisma",
    "db:push": "prisma db push --schema=prisma/schema.prisma",
    "db:migrate:dev": "prisma migrate dev --schema=prisma/schema.prisma",
    "db:migrate:deploy": "prisma migrate deploy --schema=prisma/schema.prisma",
    "db:merge:traffic-institutions": "tsx scripts/merge-traffic-institutions.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "prisma generate --schema=prisma/schema.prisma && prisma generate --schema=prisma-gazelle/schema.prisma"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/static": "^7.0.4",
    "@prisma/client": "^5.22.0",
    "fastify": "^4.28.1",
    "http-proxy": "^1.18.1",
    "jsonwebtoken": "^9.0.2",
    "ws": "^8.20.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/http-proxy": "^1.17.17",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.1",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.9"
  }
}
